# ————— PrintWater ortam değişkenleri (örnek) —————
# Bu dosyayı `.env.local` (geliştirme) veya sunucu ortamı olarak kopyalayın.
# `.env` ve `.env*.local` versiyon kontrolüne alınmaz (.gitignore).

# Bilgi Merkezi API yazma uçları (POST/PUT/DELETE) için Bearer token.
# En az 32 karakter üretin, örn:  openssl rand -hex 32
# Tanımsızsa yazma uçları 503 döner (fail-closed); site salt-okunur çalışmaya devam eder.
ARTICLES_API_TOKEN=

# Makale verisinin tutulduğu JSON dosyası. Boş bırakılırsa proje kökündeki
# `data/articles.json` kullanılır. Üretimde kalıcı bir disk yolu önerilir
# (ör. /var/lib/printwater/articles.json). Sunucusuz (Vercel) ortamda dosya
# kalıcı değildir; veritabanı tabanlı store'a geçin (bkz. .kilo/build/api-docs.md).
ARTICLES_DATA_FILE=

# İletişim formu (SMTP)
# Production yayına almadan önce bu değerleri doldurun.
# SMTP host: mail.kurumsaleposta.com
CONTACT_SMTP_HOST=mail.kurumsaleposta.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=noreply@sisnem.com
CONTACT_SMTP_PASS=
CONTACT_TO=info@printwater.com
CONTACT_FROM=noreply@sisnem.com

# Google Search Console doğrulama token'ı (metadata.verification.google).
# Tanımsızsa doğrulama meta etiketi basılmaz; üretimde mutlaka tanımlayın.
# Build-time gömülür: .env'de tanımlamak yetmez (docker ile build aşamasına ulaşması için),
# pekiştirme için hosting'in build ortamına girin veya Search Console 'html dosyası' yöntemiyle doğrulayın.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
